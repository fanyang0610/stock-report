<!doctype html>
<html lang="zh-CN">
{%- set f, v, w, F = r.f, r.v, r.w, r.fmt -%}
{%- set val = f.valuation -%}
{%- macro src(x) -%}{% if x and x.src %}<sup class="src">{% for i in x.src %}[{{ i }}]{% endfor %}</sup>{% endif %}{%- endmacro -%}
{%- macro items(list, empty="材料不足以判断") -%}
  {%- if not r.ok %}<p class="muted">（文字分析暂不可用）</p>
  {%- elif list %}<ul>{% for x in list %}<li>{% if x.title %}<b>{{ x.title }}</b>：{% endif %}{{ x.text }}{{ src(x) }}</li>{% endfor %}</ul>
  {%- else %}<p class="muted">{{ empty }}</p>{% endif -%}
{%- endmacro -%}
{%- macro p(x) -%}{{ F.pct(x) }}{%- endmacro -%}
<head>
<meta charset="utf-8">
<title>{{ f.name }} {{ f.code }} 个股研究 {{ r.doc.date }}</title>
<style>
  @page { size: A4; margin: 12mm 12mm 13mm; }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: "PingFang SC", "Hiragino Sans GB", "Heiti SC", sans-serif; font-size: 9.4pt; line-height: 1.55; color: #1f2329; }
  h1 { font-size: 18pt; margin: 0; }
  h2 { font-size: 13pt; margin: 0 0 2mm; padding-bottom: 1mm; border-bottom: 2px solid #1f2329; }
  h3 { font-size: 10.5pt; margin: 4mm 0 1.2mm; break-after: avoid; }
  p { margin: 0 0 1.2mm; }
  ul { margin: 0 0 1.5mm; padding-left: 5mm; }
  li { margin-bottom: 0.8mm; }
  section { break-before: page; }
  .muted, .sub { color: #646a73; }
  .small { font-size: 8.2pt; }
  sup.src { color: #2f54eb; font-size: 6.8pt; margin-left: 0.5mm; }
  .head { display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 2px solid #1f2329; padding-bottom: 2mm; margin-bottom: 3mm; }
  .decision { display: flex; gap: 4mm; margin-bottom: 3mm; }
  .badge { min-width: 30mm; text-align: center; color: #fff; border-radius: 3px; padding: 3mm 2mm; }
  .badge .big { font-size: 22pt; font-weight: 700; line-height: 1.1; }
  .b-买入 { background: #389e0d; } .b-持有 { background: #d48806; } .b-卖出 { background: #c41d1d; } .b-other { background: #646a73; }
  .nums { flex: 1; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5mm 3mm; align-content: center; }
  .nums div b { display: block; font-size: 12.5pt; }
  .nums div span { color: #646a73; font-size: 8pt; }
  .conclusion { background: #f0f5ff; border-left: 3px solid #2f54eb; padding: 2mm 3mm; margin: 0 0 2.5mm; font-size: 10.2pt; }
  .cols { display: flex; gap: 5mm; } .cols > div { flex: 1; min-width: 0; }
  .box { border: 1px solid #dfe2e6; border-radius: 2px; padding: 2mm 3mm; margin-top: 2mm; break-inside: avoid; }
  .agree { font-weight: 700; } .agree-相反 { color: #c41d1d; } .agree-部分一致 { color: #d48806; } .agree-一致 { color: #389e0d; }
  table { width: 100%; border-collapse: collapse; margin: 1mm 0 2mm; break-inside: avoid; }
  th { text-align: left; font-weight: 600; color: #646a73; font-size: 8.2pt; border-bottom: 1px solid #c9cdd4; padding: 0.8mm 1.4mm; }
  td { padding: 0.8mm 1.4mm; border-bottom: 1px solid #eef0f3; vertical-align: top; }
  .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  table.kv td:first-child { color: #646a73; width: 42%; }
  .chart { margin: 1mm 0 2mm; break-inside: avoid; }
  .bullbear { display: flex; gap: 4mm; } .bullbear > div { flex: 1; border-top: 3px solid; padding-top: 1mm; }
  .bull { border-color: #389e0d !important; } .bear { border-color: #c41d1d !important; }
  .warn { color: #c41d1d; }
  .back { font-size: 8.3pt; line-height: 1.5; color: #3c4149; }
  .sources td { font-size: 7.8pt; }
</style>
</head>
<body>
{# ---------- 1. the decision ---------- #}
<div class="head">
  <div><h1>{{ f.name }} <span class="sub" style="font-size:12pt">{{ f.code }} · {{ r.market_name }}</span></h1>
    <div class="sub">{{ f.industry or '' }}{% if f.damodaran.industry %} · {{ f.damodaran.industry }}{% endif %} · 类型：{{ r.type_name }}</div></div>
  <div class="sub" style="text-align:right">个股研究报告<br>数据 {{ f.price.date }} · 生成 {{ r.doc.date }}</div>
</div>
<div class="decision">
  <div class="badge b-{{ v.rating if v.rating in ('买入','持有','卖出') else 'other' }}"><div class="big">{{ v.rating }}</div><div class="small">看合理价值的评级</div></div>
  {% if v.target is number %}
  <div class="nums">
    <div><b>{{ F.price(v.target, r.q) }}</b><span>12 个月目标价</span></div>
    <div><b>{{ F.price(v.price, r.q) }}</b><span>现价（{{ f.price.date }}）</span></div>
    <div><b>{{ F.pct(v.expected_return, True) }}</b><span>预期回报（含股息）</span></div>
    <div><b>{{ F.pct(v.market_return) }}</b><span>大盘预期回报</span></div>
    <div><b>{{ F.price(v.fair_value, r.q) if v.fair_value is number else '-' }}</b><span>合理价值（约 3 年内收敛）</span></div>
    <div><b>{{ F.pct(v.fair_excess, True) if v.fair_excess is number else '-' }}</b><span>合理价值的超额回报（评级依据）</span></div>
    <div><b>±{{ F.pct(v.uncertainty.band, False, 0) }}</b><span>评级门槛：上面的超额回报须超过（不确定性越大越宽）</span></div>
    <div><b>{{ '{:,.2f}'.format(v.bear) }} — {{ F.price(v.bull, r.q) }}</b><span>12 个月悲观 — 乐观</span></div>
  </div>
  {% else %}<div class="nums"><div style="grid-column: span 4"><b>没有目标价</b><span>{{ v.reason }}</span></div></div>{% endif %}
</div>
{% if r.ok and w.conclusion %}<div class="conclusion">{{ w.conclusion.text }}{{ src(w.conclusion) }}</div>{% elif not r.ok %}<div class="conclusion warn">文字分析暂不可用（DeepSeek 未响应）：以下数字和评级照常由程序算出。</div>{% endif %}
<div class="cols">
  <div><h3>投资要点</h3>{{ items(w.points) }}</div>
  <div><h3>主要风险</h3>{{ items(w.risks) }}</div>
</div>
<div class="cols">
  <div class="box"><h3 style="margin-top:0">与每日筛选的比较：{% if r.screen.agreement %}<span class="agree agree-{{ r.screen.agreement }}">{{ r.screen.agreement }}</span>{% else %}无法比较{% endif %}</h3>
    <p>每日筛选的看法：<b>{{ r.screen.view or '不在筛选范围' }}</b>{% if r.screen.reason %}（{{ r.screen.reason }}）{% endif %}；本报告：<b>{{ v.rating }}</b>。</p>
    {% if r.ok and w.vs_screening %}<p>{{ w.vs_screening.text }}{{ src(w.vs_screening) }}</p>{% elif w.drivers_screen %}<p>{{ w.drivers_screen | join('；') }}</p>{% endif %}
  </div>
  <div class="box"><h3 style="margin-top:0">关键数据</h3>
    <table class="kv small">
      <tr><td>市值</td><td class="num">{{ F.money(val.market_cap, r.q) }}</td></tr>
      <tr><td>52 周区间</td><td class="num">{{ F.price(f.price.low_52w, r.q) }} — {{ F.price(f.price.high_52w, r.q) }}</td></tr>
      <tr><td>市盈率（过去 / 未来 12 个月）</td><td class="num">{{ F.times(val.pe_ttm) }} / {{ F.times(val.pe_fwd) }}</td></tr>
      <tr><td>市净率 · 股息率</td><td class="num">{{ F.times(val.pb) }} · {{ F.pct(val.div_yield) }}</td></tr>
      <tr><td>市场一致目标价</td><td class="num">{% if r.street.target %}{{ F.price(r.street.target, r.q) }}（{{ F.pct(r.street.upside, True, 0) }}）{% else %}无{% endif %}</td></tr>
      {% for o in r.doc.others or [] %}<tr><td>{{ r.market_names[o.market] }} {{ o.code }} 评级 · 目标价</td><td class="num">{{ o.rating }}{% if o.target is number %} · {{ F.price(o.target, o.currency) }}（{{ F.pct(o.target / o.price - 1, True, 0) }}）{% endif %}</td></tr>
      {% if o.premium is number %}<tr><td>{{ r.market_name }}较{{ r.market_names[o.market] }}溢价（按汇率折算）</td><td class="num">{{ F.pct(o.premium, True) }}</td></tr>{% endif %}{% endfor %}
      <tr><td>卖方评级</td><td class="num">{% if r.street.ratings %}{% for k, n in r.street.ratings.items() if n %}{{ {'buy':'买入','add':'增持','neutral':'中性','reduce':'减持','sell':'卖出','strongBuy':'强烈买入','hold':'持有','strongSell':'强烈卖出'}.get(k, k) }} {{ n | int }}{% if not loop.last %} · {% endif %}{% endfor %}{% else %}无{% endif %}</td></tr>
    </table>
  </div>
</div>

{# ---------- 2-3. the company, its industry ---------- #}
<section>
<h2>公司做什么</h2>
{{ items(w.business) }}
{% if f.segments %}
{%- set last = f.segments | map(attribute='period') | max -%}
<table class="small"><tr><th>主营构成（{{ last }}）</th><th>分类</th><th class="num">收入</th><th class="num">占比</th><th class="num">毛利率</th></tr>
{% for s in f.segments if s.period == last %}<tr><td>{{ s.item }}</td><td>{{ {'product':'产品','region':'地区','industry':'行业'}.get(s.by, s.by) }}</td><td class="num">{{ F.money(s.revenue, r.rc) }}</td><td class="num">{{ F.pct(s.share, False, 0) }}</td><td class="num">{{ F.pct(s.gross_margin) }}</td></tr>{% endfor %}
</table>{% elif f.market != 'cn' %}<p class="small muted">美股和港股的分部收入见上文引用的年报原文（免费数据里没有可核对的分部表）。</p>{% endif %}
<h3>行业与竞争</h3>
{{ items(w.industry) }}
{% if f.peers and f.peers.peers %}
<table class="small"><tr><th>同行（{{ f.peers.group }}，{{ f.peers.count }} 家）</th><th class="num">市值</th><th class="num">市盈率</th><th class="num">市净率</th><th class="num">ROE</th><th class="num">营收增长</th><th class="num">股息率</th></tr>
<tr><td><b>{{ f.name }}</b></td><td class="num">{{ F.money(val.market_cap, r.q) }}</td><td class="num">{{ F.times(val.pe_ttm) }}</td><td class="num">{{ F.times(val.pb) }}</td><td class="num">{{ F.pct(f.summary.roe_latest) }}</td><td class="num">{{ F.pct(f.summary.rev_cagr_3y) }}</td><td class="num">{{ F.pct(val.div_yield) }}</td></tr>
{% for x in f.peers.peers[:7] %}<tr><td>{{ x.name }}</td><td class="num">{{ F.money(x.mcap, r.q) }}</td><td class="num">{{ F.times(x.pe) }}</td><td class="num">{{ F.times(x.pb) }}</td><td class="num">{{ F.pct(x.roe) }}</td><td class="num">{{ F.pct(x.rev_growth) }}</td><td class="num">{{ F.pct(x.div_yield) }}</td></tr>{% endfor %}
<tr><td class="muted">同行中位数</td><td></td><td class="num">{{ F.times(f.peers.median.pe) }}</td><td class="num">{{ F.times(f.peers.median.pb) }}</td><td class="num">{{ F.pct(f.peers.median.roe) }}</td><td class="num">{{ F.pct(f.peers.median.rev_growth) }}</td><td class="num">{{ F.pct(f.peers.median.div_yield) }}</td></tr>
</table>{% endif %}
{% if f.industry_history %}<p class="small muted">行业估值的历史（{{ f.industry }}，半年度中位数）：{% for x in f.industry_history[-6:] %}{{ x.period[:7] }} 市盈率 {{ F.times(x.pe_median) }}{% if not loop.last %}；{% endif %}{% endfor %}。</p>{% endif %}
<h3>护城河</h3>
{{ items(w.moat) }}
</section>

{# ---------- 4. the thesis ---------- #}
<section>
<h2>多空观点</h2>
<div class="bullbear">
  <div class="bull"><h3 style="margin-top:0">多头：为什么可能更好</h3>{{ items(w.bull) }}</div>
  <div class="bear"><h3 style="margin-top:0">空头：为什么可能更差</h3>{{ items(w.bear) }}</div>
</div>
<p class="small muted">多头和空头由两次独立的调用分别写成，各自只看同样的材料，避免报告一边倒。</p>
<h3>现价假设了什么</h3>
{% set rv = v.reverse or {} %}
<ul>
{% if rv.implied_growth_5y is number %}<li>按我们的其余假设，现价相当于未来 5 年营收每年增长 <b>{{ F.pct(rv.implied_growth_5y, True) }}</b>{% if v.base_rates and v.base_rates.share_at_least.implied is number %}；{{ v.base_rates.years }} 年间同等规模（按营收第 {{ v.base_rates.fifth }} 个五分之一）的公司里，5 年做到这一增长的占 {{ F.pct(v.base_rates.share_at_least.implied, False, 0) }}{% endif %}。我们的预测是 {{ F.pct(v.forecast_growth_5y, True) }}{% if v.base_rates and v.base_rates.share_at_least.forecast is number %}（做到的占 {{ F.pct(v.base_rates.share_at_least.forecast, False, 0) }}）{% endif %}。</li>{% endif %}
{% if rv.implied_wacc is number %}<li>现价相当于资本成本 <b>{{ F.pct(rv.implied_wacc) }}</b>，我们用 {{ F.pct(v.inputs.wacc) }}。</li>{% endif %}
{% if rv.implied_margin is number %}<li>现价相当于长期营业利润率 <b>{{ F.pct(rv.implied_margin) }}</b>。</li>{% endif %}
{% if rv.implied_roe is number %}<li>按我们的股权成本 {{ F.pct(v.inputs.cost_equity) }}，现价相当于长期 ROE <b>{{ F.pct(rv.implied_roe) }}</b>；按下一年 ROE {{ F.pct(rv.roe_next) }}，现价隐含的股权成本是 {{ F.pct(rv.implied_cost_equity) }}。</li>{% endif %}
{% if rv.implied_dividend_growth_5y is number %}<li>现价相当于未来 5 年股息每年增长 <b>{{ F.pct(rv.implied_dividend_growth_5y, True) }}</b>。</li>{% endif %}
</ul>
<h3>展望</h3>
{{ items(w.outlook) }}
</section>

{# ---------- 5. financials ---------- #}
<section>
<h2>财务分析</h2>
{% if r.charts.history %}<div class="chart">{{ r.charts.history | safe }}</div>{% endif %}
{% set fin = f.kind in ('bank', 'insurer', 'broker') %}
<table class="small">
<tr><th>财年（{{ r.rcur }}）</th>{% for h in f.history[-8:] %}<th class="num">{{ h.period[:4] }}</th>{% endfor %}</tr>
<tr><td>营收</td>{% for h in f.history[-8:] %}<td class="num">{{ F.money(h.revenue) }}</td>{% endfor %}</tr>
<tr><td>净利润</td>{% for h in f.history[-8:] %}<td class="num">{{ F.money(h.ni) }}</td>{% endfor %}</tr>
{% if not fin %}<tr><td>毛利率</td>{% for h in f.history[-8:] %}<td class="num">{{ F.pct(h.gross_margin) }}</td>{% endfor %}</tr>
<tr><td>营业利润率</td>{% for h in f.history[-8:] %}<td class="num">{{ F.pct(h.ebit_margin) }}</td>{% endfor %}</tr>{% endif %}
<tr><td>净利率</td>{% for h in f.history[-8:] %}<td class="num">{{ F.pct(h.net_margin) }}</td>{% endfor %}</tr>
<tr><td>ROE</td>{% for h in f.history[-8:] %}<td class="num">{{ F.pct(h.roe) }}</td>{% endfor %}</tr>
{% if not fin %}<tr><td>投入资本回报率</td>{% for h in f.history[-8:] %}<td class="num">{{ F.pct(h.roic) }}</td>{% endfor %}</tr>
<tr><td>经营现金流 / 净利润</td>{% for h in f.history[-8:] %}<td class="num">{{ F.pct(h.ocf_to_profit, False, 0) }}</td>{% endfor %}</tr>
<tr><td>自由现金流</td>{% for h in f.history[-8:] %}<td class="num">{{ F.money(h.fcf) }}</td>{% endfor %}</tr>
<tr><td>净负债</td>{% for h in f.history[-8:] %}<td class="num">{{ F.money(h.net_debt) }}</td>{% endfor %}</tr>{% endif %}
{% if f.kind == 'bank' %}<tr><td>净息差</td>{% for h in f.history[-8:] %}<td class="num">{{ F.pct(h.nim, False, 2) if h.nim is number else '-' }}</td>{% endfor %}</tr>
<tr><td>不良率</td>{% for h in f.history[-8:] %}<td class="num">{{ F.pct(h.npl, False, 2) if h.npl is number else '-' }}</td>{% endfor %}</tr>
<tr><td>拨备覆盖率</td>{% for h in f.history[-8:] %}<td class="num">{{ F.pct(h.provision_cover, False, 0) if h.provision_cover is number else '-' }}</td>{% endfor %}</tr>
<tr><td>资本充足率</td>{% for h in f.history[-8:] %}<td class="num">{{ F.pct(h.car) if h.car is number else '-' }}</td>{% endfor %}</tr>{% endif %}
<tr><td>每股股息</td>{% for h in f.history[-8:] %}<td class="num">{{ '%.2f' | format(h.dps) if h.dps else '-' }}</td>{% endfor %}</tr>
</table>
{% set ck = f.checks %}
<div class="cols">
<div><h3>会计质量</h3>
<table class="kv small">
{% if ck.beneish %}<tr><td>Beneish M 值（&gt; -1.78 需警惕）</td><td class="num">{{ '%.2f' | format(ck.beneish.m_score) if ck.beneish.m_score is number else '-' }}{% if ck.beneish.flag %} <span class="warn">需警惕</span>{% endif %}</td></tr>{% endif %}
{% if ck.piotroski %}<tr><td>Piotroski F 值（8-9 强，0-2 弱）</td><td class="num">{{ ck.piotroski.f_score }}/{{ ck.piotroski.signals_known }}</td></tr>{% endif %}
{% if ck.altman and ck.altman.z2 is number %}<tr><td>Altman Z''（&lt; 1.1 困境）</td><td class="num">{{ '%.1f' | format(ck.altman.z2) }}</td></tr>{% endif %}
{% if ck.accruals.accruals is number %}<tr><td>应计项 / 总资产</td><td class="num">{{ F.pct(ck.accruals.accruals) }}</td></tr>{% endif %}
{% set exempt = ck.quality_screen.result == 'fail' and r.ok and w.model in ('会员费', '平台佣金', '高周转薄利') and (f.summary.roe_avg_5y or 0) > 0.2 and (f.summary.ocf_to_profit_5y or 0) > 1 %}
<tr><td>去劣筛选（7 项）</td><td class="num">{{ {'pass':'通过','fail':'未通过'}.get(ck.quality_screen.result, ck.quality_screen.result) }}{% if ck.quality_screen.failed %}（{{ ck.quality_screen.failed | join('、') }}）{% endif %}{% if exempt %}；符合豁免 C：{{ w.model }}模式，ROE 高于 20%、经营现金流高于利润{% endif %}</td></tr>
<tr><td>好生意五项</td><td class="num">{{ ck.checklist.stars }} 星{% if ck.checklist.fcf_negative_3y %} · <span class="warn">自由现金流连续 3 年为负</span>{% endif %}</td></tr>
{% set es = ck.earnings_signals %}
{% if es %}<tr><td>应收 / 存货增速快于营收</td><td class="num">{{ '是' if es.receivables_faster else '否' if es.receivables_faster is number else '-' }} / {{ '是' if es.inventory_faster else '否' if es.inventory_faster is number else '-' }}</td></tr>
<tr><td>现金流低于利润且差距扩大</td><td class="num">{{ '是' if es.cash_below_profit_widening else '否' }}</td></tr>{% endif %}
<tr><td>审计意见</td><td class="num">{{ f.audit_opinion or '-' }}</td></tr>
</table></div>
<div><h3>市场特有的信号</h3>
<table class="kv small">
{% if f.market == 'cn' and ck.cn_flags %}{% set c = ck.cn_flags %}
<tr><td>存贷双高</td><td class="num">{{ '是' if c.cash_and_debt_high else '否' }}（现金占资产 {{ F.pct(c.cash_to_assets, False, 0) }}，有息负债占资产 {{ F.pct(c.debt_to_assets, False, 0) }}）</td></tr>
<tr><td>大股东质押比例</td><td class="num">{{ F.pct(c.pledge_ratio / 100 if c.pledge_ratio is number else none) }}</td></tr>
<tr><td>商誉 / 净资产</td><td class="num">{{ F.pct(c.goodwill_to_equity) }}</td></tr>
<tr><td>未来解禁</td><td class="num">{% if c.lockups_ahead %}{% for l in c.lockups_ahead[:3] %}{{ l.date }}{% if not loop.last %}、{% endif %}{% endfor %}{% else %}无{% endif %}</td></tr>
<tr><td>近一年股东减持</td><td class="num">{{ c.holder_sells_1y }} 次</td></tr>
{% endif %}
{% if f.market == 'us' %}
<tr><td>股权激励 / 营收</td><td class="num">{{ F.pct(f.summary.sbc_to_revenue) }}</td></tr>
<tr><td>一致预期口径差（Nasdaq vs Yahoo）</td><td class="num">{{ F.pct(f.consensus.basis_gap_yahoo, False, 0) }}</td></tr>
<tr><td>内部人近 6 个月 买 / 卖</td><td class="num">{{ f.street.insider_buys_6m or 0 }} / {{ f.street.insider_sells_6m or 0 }} 笔</td></tr>
