<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>{{ r.title }} {{ r.date }}</title>
<style>
  @page { size: A4; margin: 11mm 11mm 12mm; }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: "PingFang SC", "Hiragino Sans GB", "Heiti SC", sans-serif;
         font-size: 9.2pt; line-height: 1.5; color: #1f2329; }
  h1 { font-size: 19pt; margin: 0; }
  h2 { font-size: 14pt; margin: 0 0 1mm; }
  h3 { font-size: 11pt; margin: 5mm 0 1.5mm; padding-bottom: 0.8mm; border-bottom: 1.5px solid #1f2329; break-after: avoid; }
  h3 .count { font-weight: 400; color: #646a73; font-size: 9pt; margin-left: 2mm; }
  p { margin: 0 0 1.2mm; }
  .sub, .muted { color: #646a73; }
  .small { font-size: 8.3pt; }
  .warn { color: #c41d1d; font-weight: 600; }
  .test-banner { border: 2px solid #d4380d; color: #d4380d; background: #fff2e8; font-weight: 600; padding: 2mm 3mm; margin: 3mm 0; }
  .watermark { position: fixed; top: 45%; left: 0; right: 0; text-align: center; font-size: 72pt;
               color: rgba(212, 56, 13, 0.08); transform: rotate(-30deg); pointer-events: none; z-index: -1; }
  section.market, section.back { break-before: page; }
  /* page 1 */
  .todo { margin: 2mm 0 2mm; font-size: 8.9pt; line-height: 1.45; }
  .todo p { margin: 0 0 0.6mm; }
  .todo .mk { border: 1px solid #dfe2e6; border-left: 4px solid #2f54eb; border-radius: 2px; padding: 2mm 3mm; margin-bottom: 2.5mm;
              break-inside: avoid; }
  .todo .mk h4 { margin: 0 0 1mm; font-size: 10.5pt; }
  .todo .mk h4 .sub { font-weight: 400; font-size: 8.5pt; margin-left: 2mm; }
  .k { color: #646a73; display: inline-block; min-width: 13mm; }
  .new { display: inline-block; font-size: 7.5pt; color: #fff; background: #2f54eb; border-radius: 2px; padding: 0 1mm; margin-left: 0.6mm;
         vertical-align: 1px; line-height: 1.35; }
  .guide { background: #f7f8fa; padding: 1.5mm 3mm; margin-top: 2mm; font-size: 8pt; line-height: 1.4; color: #3c4149; }
  .guide p { margin: 0 0 0.8mm; }
  table { width: 100%; border-collapse: collapse; }
  th { text-align: left; font-weight: 600; color: #646a73; font-size: 8.3pt; border-bottom: 1px solid #c9cdd4; padding: 0.8mm 1.5mm; }
  td { padding: 1mm 1.5mm; vertical-align: top; border-bottom: 1px solid #eef0f3; }
  .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  /* market pages */
  .expect { background: #f0f5ff; border-left: 3px solid #2f54eb; padding: 1.5mm 3mm; margin: 2mm 0 1mm; }
  .changes { margin: 1.5mm 0 0; }
  .card { border-bottom: 1px solid #e5e7eb; padding: 1.6mm 0 1.8mm; break-inside: avoid; }
  .card .top { display: flex; align-items: baseline; gap: 2mm; }
  .card .rank { font-weight: 700; color: #2f54eb; min-width: 6mm; }
  .card .who { flex: 1; }
  .card .who b { font-size: 10.2pt; }
  .card .right { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .card .line { padding-left: 8mm; }
  .card .biz { color: #3c4149; }
  .lbl { color: #8f959e; }
  .why { color: #237804; } .risk { color: #ad4e00; }
  .grade { display: inline-block; min-width: 9.5mm; text-align: center; font-size: 8pt; font-weight: 600; border-radius: 2px;
           padding: 0 0.8mm; margin-right: 0.6mm; }
  .gA { background: #d9f7be; } .gB { background: #f4ffb8; } .gC { background: #f0f0f0; }
  .gD { background: #fff1b8; } .gE { background: #ffccc7; } .gNone { background: #f7f7f7; color: #bbb; }
  .rv-hard { color: #c41d1d; font-weight: 600; } .rv-soft { color: #ad6800; } .rv-ok { color: #237804; } .rv-wait { color: #646a73; }
  .ai { color: #646a73; }
  .status { font-weight: 700; white-space: nowrap; }
  .s继续持有 { color: #237804; } .s复核 { color: #ad6800; } .s卖出 { color: #c41d1d; }
  .tag.test { font-size: 8pt; padding: 0 1.5mm; border-radius: 2px; background: #fff2e8; color: #d4380d; border: 1px solid #ffbb96; }
  /* back pages */
  .back { font-size: 8.6pt; color: #3c4149; }
  .back h4 { margin: 3mm 0 0.8mm; font-size: 9.5pt; color: #1f2329; }
  footer { margin-top: 5mm; padding-top: 2mm; border-top: 1px solid #c9cdd4; color: #646a73; font-size: 8.3pt; }
</style>
</head>
<body>
{% macro grades(p) %}{% for k, g in p.grades.items() %}<span class="grade g{{ g }}">{{ k[0] }} {{ g or "–" }}</span>{% endfor %}{% endmacro %}
{% macro rv(p) %}{% if p.review_shown %}<span class="rv-{{ p.review_kind or 'wait' }}">{{ '审核：未见重大风险' if p.review_kind == 'ok' else p.review_shown }}</span>{% endif %}{% endmacro %}
{% macro who(p, m) %}<b>{{ p.name }}</b> <span class="muted">{{ p.ticker }}{% if p.name_en %} · {{ p.name_en }}{% endif %}{% if p.sector %} · {{ p.sector }}{% endif %}</span>{% endmacro %}
{% if r.test %}<div class="watermark">测试数据</div>{% endif %}

<section class="overview">
  <h1>{{ r.title }} {{ r.date }}{% if r.test %} <span class="tag test">测试数据</span>{% endif %}</h1>
  <div class="sub">{% for m in r.markets %}{{ m.short }}数据 {{ m.data_date }}{% if not loop.last %} · {% endif %}{% endfor %} · 每个市场：买入 20 只 / 持仓检查 / 回避 10 只</div>
  {% if r.test %}<div class="test-banner">测试数据：本报告所有公司、价格和评分均为虚构，仅用于测试微信发送与手机打开效果。</div>{% endif %}

  <h3>今天要做什么</h3>
  {% set stale = r.markets | map(attribute="stale") | unique | list %}{% set one_stale = stale | length == 1 and stale[0] %}
  {% if one_stale %}<p class="warn small">{{ stale[0] }}（三个市场都是）</p>{% endif %}
  {% if not r.recorded and not r.test %}<p class="warn small">注意：你还没有用 hold 命令记录持仓。下面的「持仓」查的是过去 12 个月名单里、今天已不在名单中的股票，不一定是你买过的。</p>{% endif %}
  <div class="todo">
  {% for m in r.markets %}
    <div class="mk">
      <h4>{{ m.name }}<span class="sub">数据 {{ m.data_date }}</span></h4>
      {% if m.stale and not one_stale %}<p class="warn">{{ m.stale }}</p>{% endif %}
      <p><span class="k">持仓</span>{% if m.holdings %}<span class="status s卖出">卖出 {{ m.sell | length }}</span>{% if m.sell %}（{% for h in m.sell %}{{ h.short }}{% if not loop.last %}、{% endif %}{% endfor %}）{% endif %}
        · <span class="status s复核">复核 {{ m.check | length }}</span>{% if m.check %}（{% for h in m.check %}{{ h.short }}{% if not loop.last %}、{% endif %}{% endfor %}）{% endif %}
        · <span class="status s继续持有">继续持有 {{ m.keep | length }}</span>{% else %}无{% endif %}</p>
      {% if m.removed %}<p><span class="k">剔除</span>{% for p in m.removed %}{{ p.short }}：<span class="rv-hard">{{ p.reason.split("（")[0].split("：")[0] }}</span>{% if p.replaced_by %}，由 {{ p.replaced_by }} 替补{% else %}，{{ p.status }}{% endif %}{% if not loop.last %}；{% endif %}{% endfor %}</p>{% endif %}
      <p><span class="k">买入</span><b>{{ m.buys | length }} 只，每只 {{ m.share or "等额" }}，持有到 {{ m.recheck }}：</b>{% for p in m.buys %}{{ p.short }}{% if not loop.last %}、{% endif %}{% endfor %}</p>
      {% if m.changes %}<p class="small"><span class="k">变化</span>与 {{ m.changes.since }} 的名单相比{% if not m.changes.new and not m.changes.gone %}没有变化{% else %}：新进 {{ m.changes.new | length }} 只，移出 {{ m.changes.gone | length }} 只{% if m.changes.gone and m.changes.gone | length <= 8 %}（{{ m.changes.gone | join("、") }}）{% endif %}{% endif %}</p>{% endif %}
      <p class="small"><span class="k">回避</span>{% for p in m.avoid %}{{ p.short }}{% if not loop.last %}、{% endif %}{% endfor %}</p>
      <p class="small"><span class="k">预期</span>{{ m.expect.short }}</p>
    </div>
  {% endfor %}
  </div>
  <div class="guide">{% for g in r.guide %}<p>{{ g | safe }}</p>{% endfor %}</div>
</section>

{% for m in r.markets %}
<section class="market">
  <h2>{{ m.name }}{% if r.test %} <span class="tag test">测试数据</span>{% endif %}</h2>
  <div class="sub">数据日期 {{ m.data_date }} · 价格单位 {{ m.unit }}</div>
  {% if m.stale %}<p class="warn">{{ m.stale }}</p>{% endif %}
  <div class="expect"><b>预期：</b>{{ m.expect.line }}</div>

  <h3>买入组合<span class="count">{{ m.buys | length }} 只，从{{ m.field }}里选，每只 {{ m.share or "等额" }}，持有 12 个月</span></h3>
  {% if m.changes %}<p class="small muted changes">与 {{ m.changes.since }} 的名单相比：{% if m.changes.new %}新进 {{ m.changes.new | length }} 只（标「新」）{% else %}没有新进{% endif %}{% if m.changes.gone %}；移出 {{ m.changes.gone | join("、") }}{% endif %}。</p>{% endif %}
  {% for p in m.buys %}
  <div class="card buy">
    <div class="top"><span class="rank">{{ p.rank }}</span><span class="who">{{ who(p, m) }}{% if m.changes and p in m.changes.new %}<span class="new">新</span>{% endif %}</span>
      <span class="right"><b>{{ p.price | num }}</b> <span class="muted small">{{ p.lot_text }} · 复查 {{ p.recheck }}</span></span></div>
    {% if p.business %}<div class="line biz small">{{ p.business }}</div>{% endif %}
    <div class="line">{{ grades(p) }} <span class="lbl">为什么买：</span><span class="why">{{ p.why }}</span></div>
    <div class="line"><span class="lbl">{{ p.risk_label }}：</span><span class="risk">{{ p.risk_text }}</span>{% if p.review_kind == 'ok' %}　{{ rv(p) }}{% endif %}</div>
    {% if p.review_shown and p.review_kind != 'ok' %}<div class="line small">{{ rv(p) }}</div>{% endif %}
    {% if p.note %}<div class="line small ai">AI 点评：{{ p.note }}</div>{% endif %}
  </div>
  {% endfor %}
  {% if m.review %}<p class="warn small">{{ m.review }}</p>{% endif %}

  {% if m.removed %}
  <h3>审核剔除<span class="count">{{ m.removed | length }} 只，由同行业下一名替补</span></h3>
  <table><tbody>{% for p in m.removed %}<tr><td style="width:30%"><b>{{ p.name }}</b> <span class="muted">{{ p.ticker }} · 原第 {{ p.rank }} 名</span></td>
    <td class="rv-hard">{{ p.reason }}</td><td style="width:24%">{% if p.replaced_by %}由 {{ p.replaced_by }} 替补{% else %}{{ p.status }}{% endif %}</td></tr>{% endfor %}</tbody></table>
  {% endif %}
  {% if m.vetoes %}<p class="small muted">不列入（你的否决）：{% for v in m.vetoes %}{{ v.ticker }} {{ v.name }} {{ v.reason }}{% if not loop.last %}；{% endif %}{% endfor %}</p>{% endif %}

  <h3>持仓检查<span class="count">{% if m.holdings %}卖出 {{ m.sell | length }} · 复核 {{ m.check | length }} · 继续持有 {{ m.keep | length }}{% else %}无{% endif %}</span></h3>
  {% if not r.recorded and m.holdings and not r.test %}<p class="small muted">你还没有记录持仓（hold 命令）：这里检查的是过去 12 个月买入组合里、今天已不在组合中的股票。</p>{% endif %}
  {% for h in m.sell + m.check %}
  <div class="card">
    <div class="top"><span class="status s{{ h.status }}">{{ h.status }}</span><span class="who">{{ who(h, m) }}</span>
      <span class="right muted small">买入 {{ h.since }} · 复查 {{ h.recheck }}</span></div>
    {% if h.business %}<div class="line biz small">{{ h.business }}</div>{% endif %}
    <div class="line">{% if h.grades["价值"] %}{{ grades(h) }} {% endif %}<span class="lbl">原因：</span>{{ h.reason }}</div>
    {% if h.review_shown and h.review_kind != 'ok' %}<div class="line small">{{ rv(h) }}</div>{% endif %}
    {% if h.note %}<div class="line small ai">AI 点评：{{ h.note }}</div>{% endif %}
  </div>
  {% endfor %}
  {% if m.keep %}
  <p class="small muted" style="margin-top:2mm">继续持有：评分仍在同行业前半（或满 12 个月仍在前五分之一），到复查日再看。</p>
  <table class="small"><thead><tr><th>名称</th><th>买入日</th><th>评级</th><th>复查日</th><th>AI 点评</th></tr></thead><tbody>
  {% for h in m.keep %}<tr><td><b>{{ h.name }}</b> <span class="muted">{{ h.ticker }}</span></td><td class="num">{{ h.since }}</td>
    <td style="white-space:nowrap">{{ grades(h) }}</td><td class="num">{{ h.recheck }}</td><td class="ai">{{ h.note or "" }}</td></tr>{% endfor %}
  </tbody></table>
  {% endif %}

  <h3>回避<span class="count">市值前 400 里评分最低的 {{ m.avoid | length }} 只</span></h3>
  {% for p in m.avoid %}
  <div class="card">
    <div class="top"><span class="rank">{{ loop.index }}</span><span class="who">{{ who(p, m) }}</span><span class="right"><b>{{ p.price | num }}</b></span></div>
    {% if p.business %}<div class="line biz small">{{ p.business }}</div>{% endif %}
    <div class="line">{{ grades(p) }} <span class="lbl">为什么回避：</span><span class="risk">{{ p.avoid_why }}</span></div>
    {% if p.review_shown and p.review_kind not in ('ok', 'wait') %}<div class="line small">{{ rv(p) }}</div>{% endif %}
    {% if p.note %}<div class="line small ai">AI 点评：{{ p.note }}</div>{% endif %}
  </div>
  {% endfor %}
</section>
{% endfor %}

<section class="back">
  <h2>附：方法、依据和审核规则</h2>
  {% for title, text in r.method %}<h4>{{ title }}</h4><p>{{ text }}</p>{% endfor %}
  <h4>预期的依据</h4>
  {% for m in r.markets %}<p><b>{{ m.name }}：</b>{{ m.expect.line }}{% for line in m.expect.detail %} {{ line }}{% endfor %}</p>{% endfor %}
  <p>{{ r.common }}</p>
  <footer>
    {% for m in r.markets %}{{ m.name }} 数据日期 {{ m.data_date }}{% if m.stale %}（<span class="warn">{{ m.stale }}</span>）{% endif %}{% if not loop.last %} · {% endif %}{% endfor %}<br>
    {% if r.storage_warning %}<span class="warn">{{ r.storage_warning }}</span><br>{% endif %}
    本报告由程序根据公开数据自动生成，不构成投资建议。{% if r.test %}<b>（测试数据）</b>{% endif %}
  </footer>
</section>
</body>
</html>
