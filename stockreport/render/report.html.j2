<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>{{ r.title }} {{ r.date }}</title>
<style>
  @page { size: A4; margin: 12mm 10mm 12mm; }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: "PingFang SC", "Hiragino Sans GB", "Heiti SC", sans-serif;
         font-size: 9.5pt; line-height: 1.45; color: #1f2329; }
  h1 { font-size: 18pt; margin: 0 0 2mm; }
  h2 { font-size: 13pt; margin: 0 0 2mm; padding-bottom: 1mm; border-bottom: 2px solid #1f2329; }
  .sub { color: #646a73; font-size: 9pt; }
  .test-banner { border: 2px solid #d4380d; color: #d4380d; background: #fff2e8; font-weight: 600;
                 padding: 2mm 3mm; margin: 3mm 0; }
  .watermark { position: fixed; top: 45%; left: 0; right: 0; text-align: center; font-size: 72pt;
               color: rgba(212, 56, 13, 0.08); transform: rotate(-30deg); pointer-events: none; z-index: -1; }
  .legend { background: #f7f8fa; border-left: 3px solid #c9cdd4; padding: 2mm 3mm; margin: 3mm 0 4mm;
            color: #3c4149; font-size: 8.5pt; }
  .legend p, .expect p { margin: 0 0 1mm; }
  .expect { background: #f0f5ff; border-left: 3px solid #2f54eb; padding: 2mm 3mm; margin: 2mm 0 3mm; font-size: 8.5pt; }
  .warn { color: #d4380d; font-weight: 600; }
  section { margin-top: 5mm; }
  section.market { break-before: page; }
  table { width: 100%; border-collapse: collapse; }
  table.cards { table-layout: fixed; }
  th { text-align: left; font-weight: 600; color: #646a73; font-size: 8.5pt;
       border-bottom: 1px solid #c9cdd4; padding: 1mm 1.5mm; }
  td { padding: 1.2mm 1.5mm; vertical-align: top; }
  .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .rows td { border-bottom: 1px solid #eef0f3; }
  tbody.card { break-inside: avoid; }
  tbody.card tr.head td { border-top: 1px solid #c9cdd4; padding-top: 2mm; }
  tbody.card tr.body td { padding-bottom: 2.5mm; color: #3c4149; }
  .ticker { font-weight: 700; }
  .grade { display: inline-block; min-width: 4.5mm; text-align: center; font-weight: 700; border-radius: 2px;
           padding: 0 1mm; margin-left: 0.5mm; }
  .gA { background: #d9f7be; } .gB { background: #f4ffb8; } .gC { background: #f5f5f5; }
  .gD { background: #fff1b8; } .gE { background: #ffccc7; }
  .status { font-weight: 600; white-space: nowrap; }
  .s继续持有 { color: #237804; } .s复核 { color: #ad6800; } .s卖出 { color: #c41d1d; }
  .tag { display: inline-block; font-size: 8pt; padding: 0 1.5mm; border-radius: 2px; margin-left: 1mm; }
  .tag.test { background: #fff2e8; color: #d4380d; border: 1px solid #ffbb96; }
  .label { color: #8f959e; }
  .list-title { font-size: 11pt; font-weight: 700; margin: 4mm 0 1mm; }
  footer { margin-top: 6mm; padding-top: 2mm; border-top: 1px solid #c9cdd4; color: #646a73; font-size: 8.5pt; }
</style>
</head>
<body>
{% macro grades(p) %}{% for k, g in p.grades.items() %}{{ k[0] }}<span class="grade g{{ g }}">{{ g }}</span> {% endfor %}{% endmacro %}
{% if r.test %}<div class="watermark">测试数据</div>{% endif %}

<section class="overview">
  <h1>{{ r.title }}{% if r.test %} <span class="tag test">测试数据</span>{% endif %}</h1>
  <div class="sub">{{ r.date }} · {% for m in r.markets %}{{ m.name }}{% if not loop.last %} / {% endif %}{% endfor %}
    · 每个市场：买入组合 20 只 / 持仓检查 / 回避 10 只</div>
  {% if r.test %}<div class="test-banner">测试数据：本报告所有公司、价格和评分均为虚构，仅用于测试微信发送与手机打开效果。</div>{% endif %}
  <div class="legend">
    <p><b>怎么读：</b>{{ r.method }}</p>
    <p><b>评级：</b>价、质、动分别是价值、质量、动量的五分位，A 为最好的五分之一，E 为最差的五分之一；价、质在金融股（银行、保险、券商和其他放贷机构）之间和其他股票之间分别排，动在全市场排。
      <b>理由</b>是该股最强的两项指标，<b>风险</b>是亏损、负债率 70% 以上、近 6 个月跌超 30%，否则为最弱的一项。</p>
    <p><b>持仓检查（每只持有 12 个月）：</b>继续持有 = 未满 12 个月且评分在前半，或满 12 个月仍在前五分之一；复核 = 未满 12 个月但评分跌入后半；
      卖出 = 满 12 个月已不在前五分之一（换入未持有的最高分股票）。记录持仓：<code>hold 代码 --date 买入日</code>；没有记录时检查过去 12 个月买入组合里今天不在组合的股票。</p>
    <p><b>预期：</b>{{ r.common }}</p>
  </div>
  <table class="rows">
    <colgroup><col style="width:13%"><col style="width:44%"><col style="width:11%"><col style="width:32%"></colgroup>
    <thead><tr><th>市场</th><th>买入组合前 10</th><th>持仓检查</th><th>回避</th></tr></thead>
    <tbody>
    {% for m in r.markets %}
      <tr>
        <td><b>{{ m.name }}</b><br><span class="sub">数据 {{ m.data_date }}</span>{% if m.stale %}<br><span class="warn">{{ m.stale }}</span>{% endif %}</td>
        <td>{% if m.core %}<b>{{ m.core_short }}</b>；{% endif %}{% for p in m.buys[:10] %}{{ p.ticker }} {{ p.name }}{% if not loop.last %}、{% endif %}{% endfor %}</td>
        <td>{% for s in ["继续持有", "复核", "卖出"] %}{% set n = m.holdings | selectattr("status", "equalto", s) | list | length %}{% if n %}<span class="status s{{ s }}">{{ s }} {{ n }}</span> {% endif %}{% endfor %}{% if not m.holdings %}—{% endif %}</td>
        <td>{% for p in m.avoid %}{{ p.name }}{% if not loop.last %}、{% endif %}{% endfor %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</section>

{% for m in r.markets %}
<section class="market">
  <h2>{{ m.name }}{% if r.test %} <span class="tag test">测试数据</span>{% endif %}</h2>
  <div class="sub">数据日期 {{ m.data_date }} · 计价 {{ m.currency }}</div>
  {% if m.stale %}<div class="warn">{{ m.stale }}</div>{% endif %}
  {% if m.core %}<div class="expect"><b>{{ m.core }}</b></div>{% endif %}
  <div class="expect"><b>预期</b>{% for line in m.expect %}<p>{{ line }}</p>{% endfor %}</div>

  <div class="list-title">买入组合（{{ m.buys | length }} 只，等额买入，持有 12 个月{% if m.core %}；配合上面的指数基金{% endif %}）</div>
  <table class="cards">
    <colgroup><col style="width:6%"><col style="width:36%"><col style="width:14%"><col style="width:24%"><col style="width:20%"></colgroup>
    <thead><tr><th>#</th><th>代码 / 名称 / 行业</th><th class="num">现价</th><th>评级</th><th class="num">一手</th></tr></thead>
    {% for p in m.buys %}
    <tbody class="card">
      <tr class="head">
        <td><b>{{ p.rank }}</b></td>
        <td><span class="ticker">{{ p.ticker }}</span> {{ p.name }} <span class="sub">{{ p.sector }}</span></td>
        <td class="num">{{ p.price | num }}<br><span class="sub">{{ p.price_date }}</span></td>
        <td>{{ grades(p) }}<br><span class="sub">市场第 {{ p.score_rank }} 名</span></td>
        <td class="num">{{ p.lot_text }}</td>
      </tr>
      <tr class="body">
        <td></td>
        <td colspan="4"><span class="label">理由：</span>{{ p.why }}　<span class="label">风险：</span>{{ p.risk }}<br>
          <span class="label">复查：</span>{{ p.recheck }}（满 12 个月）；若评分跌入后半，提前复查</td>
      </tr>
    </tbody>
    {% endfor %}
  </table>
  {% if m.vetoes %}<p class="sub">不列入（你的否决）：{% for v in m.vetoes %}{{ v.ticker }} {{ v.name }} {{ v.reason }}{% if not loop.last %}；{% endif %}{% endfor %}</p>{% endif %}

  <div class="list-title">持仓检查</div>
  {% if m.holdings %}
  <table class="rows">
    <thead><tr><th>代码 / 名称</th><th>买入日</th><th>结论</th><th>原因</th><th>评级</th><th>复查</th></tr></thead>
    <tbody>
    {% for h in m.holdings %}
      <tr><td><span class="ticker">{{ h.ticker }}</span> {{ h.name or "" }}</td><td>{{ h.since }}</td>
        <td class="status s{{ h.status }}">{{ h.status }}</td><td>{{ h.reason }}</td>
        <td>{% if h.grades["价值"] %}{{ grades(h) }}{% endif %}</td><td>{{ h.recheck }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}<p class="sub">没有记录的持仓，也没有过去 12 个月的组合记录。</p>{% endif %}

  <div class="list-title">回避（市值前 400 中评分最低的 {{ m.avoid | length }} 只）</div>
  <table class="rows">
    <thead><tr><th>代码 / 名称 / 行业</th><th class="num">现价</th><th>评级</th><th>最弱</th><th>原因</th></tr></thead>
    <tbody>
    {% for p in m.avoid %}
      <tr><td><span class="ticker">{{ p.ticker }}</span> {{ p.name }} <span class="sub">{{ p.sector }}</span></td>
        <td class="num">{{ p.price | num }}</td><td>{{ grades(p) }}</td><td>{{ p.weakest }}</td>
        <td>{{ p.weak }}{% if p.risk and p.risk not in p.weak %}；{{ p.risk }}{% endif %}</td></tr>
    {% endfor %}
    </tbody>
  </table>
</section>
{% endfor %}

<footer>
  {% for m in r.markets %}{{ m.name }} 数据日期 {{ m.data_date }}{% if m.stale %}（<span class="warn">{{ m.stale }}</span>）{% endif %}{% if not loop.last %} · {% endif %}{% endfor %}<br>
  {% if r.storage_warning %}<span class="warn">{{ r.storage_warning }}</span><br>{% endif %}
  本报告由程序根据公开数据自动生成，不构成投资建议。{% if r.test %}<b>（测试数据）</b>{% endif %}
</footer>
</body>
</html>
